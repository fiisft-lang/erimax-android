{
  "appId": "com.webapp.erimaxmanuteno",
  "appName": "EriMax Manutenção",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "LiveUpdate": {
      "autoUpdateStrategy": "none",
      "autoBlockRolledBackBundles": true,
      "autoDeleteBundles": true,
      "readyTimeout": 30000,
      "defaultChannel": "production"
    }
  }
}
